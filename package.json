{
  "name": "dsh-study-kit",
  "version": "0.9.0",
  "description": "【学习】资料整合与备考出题：把教材/笔记/课件/习题/历年真题解析入库，切章建索引、统计考点热度、按真题风格出模拟卷命题蓝图，并把结果导出成 Word/PDF。纯本地、零依赖、不出网。",
  "meta": {
    "title": "（学习）资料整合",
    "description": "解析 docx/pptx/pdf/文本资料，清洗切章建索引，统计真题考点热度，按真题风格生成模拟卷命题蓝图，把按章笔记打包成 Word/PDF 课程资料，也能把库里任意资料直接导出成 Word/PDF。"
  },
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "check": "node --check lib/index.js && node --check lib/tools.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "scripts",
    "examples",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "study",
    "exam",
    "pdf",
    "docx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKYSNOWSTARMOON/dsh-study-kit.git"
  },
  "homepage": "https://github.com/SKYSNOWSTARMOON/dsh-study-kit#readme",
  "bugs": {
    "url": "https://github.com/SKYSNOWSTARMOON/dsh-study-kit/issues"
  },
  "author": "dsh-study-kit contributors",
  "license": "MIT"
}
